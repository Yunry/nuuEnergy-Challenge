{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build_vercel.py",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": [
        "scripts/**",
        "src/decision_engine/**",
        "data/demo/**",
        "data/customers/**",
        "data/customer/**",
        "data/raw/**"
      ],
      "excludeFiles": [
        "**/__pycache__/**",
        "data/demo/*/raw/documents/**",
        "data/demo/*/raw/photos/**",
        ".env*",
        "tests/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py?_route=/api/:path*" }
  ]
}
